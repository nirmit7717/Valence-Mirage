# Valence Mirage — Environment Variables
# Copy this to .env and fill in your values

# NVIDIA NIM API key
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Stable defaults verified against the current NVIDIA account
INTENT_MODEL=meta/llama-3.2-11b-vision-instruct
NARRATOR_MODEL=meta/llama-3.2-11b-vision-instruct
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
API_PORT=8001
